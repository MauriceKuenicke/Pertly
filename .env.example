# Pertly configuration for `docker compose` / `make up`.
# Copy to `.env` and adjust. Every variable is optional; the values shown are
# the defaults used when the variable is absent.

# Host port the web UI is published on (http://localhost:8080).
PERTLY_PORT=8080

# Allow anyone who can reach the UI to create an account.
# The very first account can always register and becomes admin, even when
# this is false -- unless a bootstrap admin is configured via ADMIN_* below.
# After setting up your team, consider ALLOW_REGISTRATION=false and creating
# accounts from the admin screen instead.
ALLOW_REGISTRATION=true

# Mark the session cookie `Secure`. Set to true when Pertly is served over
# HTTPS (e.g. behind a TLS-terminating reverse proxy). Leave false for plain
# http:// on an internal host, otherwise browsers drop the cookie and login
# silently fails.
COOKIE_SECURE=false

# Lifetime of a login session, in days.
SESSION_TTL_DAYS=30

# Backend log level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Optional bootstrap admin, created at startup only if no user exists yet.
# If unset, whoever registers first becomes admin. Alternatively create one
# later with `make docker-create-admin EMAIL=... FIRST=... LAST=...`.
# Remove ADMIN_PASSWORD from this file after the first start.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=Change-me-1
# ADMIN_FIRST_NAME=Admin
# ADMIN_LAST_NAME=User
